<core:FragmentDefinition
    xmlns:core="sap.ui.core"
    xmlns:gnt2="sap.gantt.simple"
    core:require="{
		formatMessage: 'sap/base/strings/formatMessage'
	}"
>
    <gnt2:BaseRectangle
        shapeId="{data>shapeId}"
        time="{path:'data>StartTime', formatter:'.formatter.dateToObjectByZone'}"
        endTime="{path:'data>EndTime', formatter:'.formatter.dateToObjectByZone'}"
         height="{= ${data>Type} === 'REST'? 14 : 12 }"
        rx="4"
        ry="4"
        fill="{= ${data>Type} === 'REST' ? '#bac8e4' : ${data>Type} === 'BREAK' ? '#E9730C' : '#64748B'}"
        stroke="{= ${data>Type} === 'REST'? '#4C1D95' : ${data>Type} === 'REST'? '#ffffff': '#475569'}"        
        strokeWidth="2"
        title="{data>Title}"
        showTitle="false"        
        class="restBreakShapeTitle"
        titleColor="#BLACK"
        selectable="false"
        draggable="false"
        resizable="false"    
       
    />
