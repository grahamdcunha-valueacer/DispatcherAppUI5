<core:FragmentDefinition
    xmlns="sap.ui.table"
    xmlns:m="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:axistime="sap.gantt.axistime"
    xmlns:config="sap.gantt.config"
    xmlns:gnt2="sap.gantt.simple"
    xmlns:gnt-cal="sap.gantt.def.cal"
    xmlns:demokit="dispatcherns.dispatcherproj"
    xmlns:rm="sap.ui.table.rowmodes"
    core:require="{
		formatMessage: 'sap/base/strings/formatMessage'
	}"
>
    <gnt2:GanttChartWithTable
        id="Driver"
        ghostAlignment="Start"
        adhocLineLayer="Bottom"
        shapeSelectionMode="Multiple"
        enableChartOverflowToolbar="true"
        shapeSelectionSettings="{color:'sapNegativeElementColor', strokeDasharray:'1,0'}"
        shapeDrop=".onShapeDrop"
        shapeResize=".onOrderRescheduled"
        shapeDoubleClick=".onShapeDoubleClick"
        class="driverGanttCard"
        
    >
        <gnt2:table>
            <Table
                selectionMode="Single"
                selectionBehavior="RowSelector"
                enableColumnReordering="true"
                fixedColumnCount="1"
                width="auto"
                class="driverGanttCard sapUiResponsiveContentPadding"
                rows="{
					path: 'data>/Drivers',
					parameters: {
						operationMode: 'Server'						
					}
				}"
            >
                <extension>
                    <m:OverflowToolbar
                        class="driverToolbar sapUiResponsiveContentPadding sapUiSmallMarginTop"
                    >
                        <m:Title
                            text="Drivers"
                            level="H2"
                        />

                        <m:ToolbarSpacer />
                        <m:Button
                            icon="sap-icon://expand-all"
                            type="Transparent"
                            press=".showUtilization"
                        />
                        <m:Button
                            icon="sap-icon://collapse-all"
                            type="Transparent"
                            press=".hideUtilization"
                        />
                        <m:Button icon="sap-icon://refresh" />
                    </m:OverflowToolbar>
                </extension>
                <rowMode>
                    <rm:Auto minRowCount="5" />
                </rowMode>
                <rowSettingsTemplate>
                    <gnt2:GanttRowSettings rowId="{data>driverID}" shapes1="{data>ShiftShapes}"
                        shapes2="{data>FOShapes}"
                    >
                    <gnt2:calendars>
							<gnt2:BaseCalendar shapeId="{data>driverID}" calendarName="{data>driverID}" fill="#ffffff"/>
						</gnt2:calendars> 
					<!-- Driver validity background -->

                        <gnt2:shapes1>
							<gnt2:BaseRectangle
									shapeId="{data>shapeId}"
									time="{
											path: 'data>StartTime',
											formatter: '.formatter.dateToObjectByZone'
										  }"
									endTime="{
											path: 'data>EndTime',
											formatter: '.formatter.dateToObjectByZone'
											}"
									
									fill="#bccaaf"
									stroke="#cccccc"
									strokeWidth="1"
                                    transform=""
									height="22"
									rx="6"
									ry="6"
									countInBirdEye="false"
									selectable="false"
									draggable="false"
									resizable="false"/>
							</gnt2:shapes1>
                        <gnt2:shapes2>
                             <gnt2:BaseDiamond>
							</gnt2:BaseDiamond>	
                            <gnt2:BaseRectangle
                                shapeId="{data>driverID}"
                                time="{
								path:'data>StartTime',
								formatter:'.formatter.dateToObject'
								}"
                                endTime="{
								path:'data>EndTime',
								formatter:'.formatter.dateToObject'
								}"
                                fill="#99D101"
                                stroke="#ffffff"
                                height="20"
                                strokeWidth="1"
                                rx="4"
                                ry="4"
                                title="{data>Title}"
									showTitle="true"
									titleColor="#1D2D3E"
                                countInBirdEye="true"
                                
                                tooltip="{
											parts: [
												'i18n>DriverTooltip',
												'data>driverID',
												'data>StartTime',
												'data>EndTime'
											],
											formatter: 'formatMessage'
									}"
                                expandable="false"
                                selectable="true"
                                draggable="true"
                                resizable="false"
                            />
                        </gnt2:shapes2>

						<!-- Individual daily shifts -->
							
                    </gnt2:GanttRowSettings>
                </rowSettingsTemplate>
                <columns>
                    <Column>
                        <m:Text text="Select" />
                        <m:CheckBox
                            text="Select"
                            select=".onSelectDrivers"
                        />
                    </Column>
                    <Column
                        sortProperty="driverID"
                        filterProperty="driverID"
                        width="95px"
                    >
                        <m:Text text="Driver ID" />
                        <template>
                            <m:Label text="{data>driverID}" />
                        </template>
                    </Column>
                    <Column
                        sortProperty="firstName"
                        filterProperty="firstName"
                        width="95px"
                    >
                        <m:Text text="First Name" />
                        <template>
                            <m:Label text="{data>firstName}" />
                        </template>
                    </Column>
                    <Column
                        sortProperty="lastName"
                        filterProperty="lastName"
                        width="95px"
                    >
                        <m:Text text="Last Name" />
                        <template>
                            <m:Label text="{data>lastName}" />
                        </template>
                    </Column>
                </columns>
            </Table>
        </gnt2:table>

        <gnt2:shapeSchemes>
            <gnt2:ShapeScheme
                key="driver"
                primary="true"
            />
            <gnt2:ShapeScheme
                key="driver_to_ulc"
                rowSpan="2"
            />
        </gnt2:shapeSchemes>

        <gnt2:axisTimeStrategy>
            <core:Fragment
                fragmentName="dispatcherns.dispatcherproj.view.AxisTimeStrategy"
                type="XML"
            />
        </gnt2:axisTimeStrategy>

        <!-- <gnt2:calendarDef>
			<gnt-cal:CalendarDefs defs="{ path:'calc>/'}">
				<gnt-cal:Calendar key="{calc>CalendarId}" timeIntervals="{path:'calc>Intervals', templateShareable: true}" backgroundColor="{= ${calc>CalendarId} === 'nwt' ? '#666' : '#ccc' }">
					<gnt-cal:TimeInterval startTime="{calc>StartDateTime}" endTime="{calc>EndDateTime}"/>
				</gnt-cal:Calendar>
			</gnt-cal:CalendarDefs>
		</gnt2:calendarDef> -->
    </gnt2:GanttChartWithTable>
</core:FragmentDefinition>
