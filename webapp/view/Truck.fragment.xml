<core:FragmentDefinition
	xmlns="sap.ui.table"
	xmlns:m="sap.m"
	xmlns:core="sap.ui.core"
	xmlns:axistime="sap.gantt.axistime"
	xmlns:config="sap.gantt.config"
	xmlns:gnt2="sap.gantt.simple"
	xmlns:gnt-cal="sap.gantt.def.cal"
	xmlns:demokit="dispatcherns.dispatcherproj"
	xmlns:rm="sap.ui.table.rowmodes"
	core:require="{
		formatMessage: 'sap/base/strings/formatMessage'
	}">
	
	<gnt2:GanttChartWithTable id="Truck" ghostAlignment="Start" adhocLineLayer="Bottom"
			shapeSelectionMode = "Multiple"
			enableChartOverflowToolbar="true"
			shapeSelectionSettings="{color:'sapNegativeElementColor', strokeDasharray:'1,0'}"
			shapeDrop=".onShapeDrop"
			shapeResize=".onOrderRescheduled"
			shapeDoubleClick=".onShapeDoubleClick"
			class="truckGanttCard">
			
		<gnt2:table >		
			<Table
				selectionMode="Single"
				selectionBehavior="RowSelector"
				enableColumnReordering="true"
				fixedColumnCount = "1"
				width="auto"
				class="foGanttCard sapUiResponsiveContentPadding"				
				rows="{
					path: 'data>/Resources',
					parameters: {
						operationMode: 'Server'						
					}
				}">
				<extension>
					<m:OverflowToolbar class="truckToolbar sapUiResponsiveContentPadding sapUiSmallMarginTop">
						<m:Title text="Vehicle" level="H2" /> 
						<m:ToolbarSpacer/>
						<m:Button icon="sap-icon://expand-all" type="Transparent" press=".showUtilization"/>
						<m:Button icon="sap-icon://collapse-all" type="Transparent" press=".hideUtilization"/>
						<m:Button icon="sap-icon://refresh"/>						
					</m:OverflowToolbar>
				</extension>
				<rowMode>
					<rm:Auto minRowCount="5"/>
				</rowMode>
				<rowSettingsTemplate>
					<gnt2:GanttRowSettings rowId="{data>resourceId}" shapes1="{data>AvailabilityShapes}" shapes2="{data>FOShapes}">						
						<gnt2:calendars>
							<gnt2:BaseCalendar shapeId="{data>resourceId}" calendarName="{data>resourceId}" fill="#ffffff"/>
						</gnt2:calendars> 
						 <gnt2:shapes1>
							<gnt2:BaseDiamond>
							</gnt2:BaseDiamond>	

							<gnt2:BaseRectangle
								shapeId="{data>shapeId}"
								time="{
								path:'data>StartTime',
								formatter:'.formatter.dateToObject'
								}"
								endTime="{
								path:'data>EndTime',
								formatter:'.formatter.dateToObject'
								}"
								fill="#bccaaf"
								height="22"							
								countInBirdEye="true"
								showTitle="true"
								tooltip="{
											parts: [
												'i18n>VehicleTooltip',
												'data>resourceId',
												'data>StartTime',
												'data>EndTime'
											],
											formatter: 'formatMessage'
									}"
								expandable="true" selectable="true" draggable="true" resizable="true"/>		
									
						</gnt2:shapes1>
						<!-- Assigned Freight Orders -->
						<gnt2:shapes2>
							<gnt2:BaseRectangle
								shapeId="{data>shapeId}"
								time="{
								path:'data>StartTime',
								formatter:'.formatter.dateToObject'
								}"
								endTime="{
								path:'data>EndTime',
								formatter:'.formatter.dateToObject'
								}"
								fill="#99D101"
								stroke="#ffffff"
								strokeWidth="1"
								rx="6" ry="6"
								height="22"							
								countInBirdEye="true"
								showTitle="true"
								title = "{
												parts:[
													{ path:'data>Title' }
												],
												formatter: '.formatter.orderTitle'
											}"
								tooltip="{
											parts: [
												'i18n>VehicleTooltip',
												'data>Title',
												'data>StartTime',
												'data>EndTime'
											],
											formatter: 'formatMessage'
									}"									
								
								expandable="false" selectable="false" draggable="false" resizable="false"/>	
						</gnt2:shapes2>
						
					</gnt2:GanttRowSettings>
				</rowSettingsTemplate>
				<columns>
					<Column>
						<m:Text text="Select"/>
						<m:CheckBox text="Select" selected="{data>selected}" select=".onSelectTruck"></m:CheckBox>
					</Column>
					<Column sortProperty="resourceId" filterProperty="resourceId" width="140px">
						<m:Text text="Vehicle ID"/>
						<template>
							<m:Label text="{data>resourceId}"/>
						</template>
					</Column>
					<!-- <Column sortProperty="resourceType" filterProperty="resourceType">
						<m:Text text="Resource Type"/>
						<template>
							<m:Label text="{data>resourceType}"/>
						</template>
					</Column> -->
					<Column sortProperty="description" filterProperty="description" width="140px">
						<m:Text text="Vehicle Description" />
						<template>
							<m:Label text="{data>description}"/>
						</template>
					</Column>					
				</columns>
			</Table>
		</gnt2:table>

		<gnt2:shapeSchemes>
			<gnt2:ShapeScheme key="truck" primary="true"/>
			<gnt2:ShapeScheme key="truck_to_ulc" rowSpan="2"/>
		</gnt2:shapeSchemes>

		<gnt2:axisTimeStrategy>
			<core:Fragment fragmentName="dispatcherns.dispatcherproj.view.AxisTimeStrategy" type="XML"/>
		</gnt2:axisTimeStrategy>

		<!-- <gnt2:calendarDef>
			<gnt-cal:CalendarDefs defs="{ path:'calc>/'}">
				<gnt-cal:Calendar key="{calc>CalendarId}" timeIntervals="{path:'calc>Intervals', templateShareable: true}" backgroundColor="{= ${calc>CalendarId} === 'nwt' ? '#666' : '#ccc' }">
					<gnt-cal:TimeInterval startTime="{calc>StartDateTime}" endTime="{calc>EndDateTime}"/>
				</gnt-cal:Calendar>
			</gnt-cal:CalendarDefs>
		</gnt2:calendarDef> -->

	</gnt2:GanttChartWithTable>
</core:FragmentDefinition>
