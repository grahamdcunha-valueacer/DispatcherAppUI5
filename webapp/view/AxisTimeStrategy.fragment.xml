<core:FragmentDefinition 
	xmlns="sap.ui.table"
	xmlns:m="sap.m"
	xmlns:core="sap.ui.core"
	xmlns:axistime="sap.gantt.axistime"
	xmlns:config="sap.gantt.config"
	xmlns:gnt2="sap.gantt.simple">

	<axistime:ProportionZoomStrategy>
		<axistime:totalHorizon>
			<config:TimeHorizon 
				startTime="{horizon>/total_horizonStart}" 
				endTime="{horizon>/total_horizonEnd}"/>
		</axistime:totalHorizon>
		
		<axistime:visibleHorizon>
			<config:TimeHorizon 
				startTime="{horizon>/horizonStart}" 
				endTime="{horizon>/horizonEnd}"/>
		</axistime:visibleHorizon>
	</axistime:ProportionZoomStrategy>

</core:FragmentDefinition>